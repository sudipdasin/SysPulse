#!/usr/bin/python3
"""Manage a separate, persistent Brave launcher; never replace the vendor launcher."""
import os, re, stat, sys, tempfile, unittest
from pathlib import Path

NAME = 'syspulse-brave-cache.desktop'
EXES = ('/usr/bin/brave-browser', '/usr/bin/brave-browser-stable')

def cap(value):
    if not re.fullmatch(r'[1-9][0-9]{1,3}', str(value)) or not 64 <= int(value) <= 2048:
        raise ValueError('Cache limit must be 64–2048 MiB')
    return int(value)

def contents(exe, mib):
    if exe not in EXES: raise ValueError('Unexpected browser executable')
    return ('[Desktop Entry]\nType=Application\nName=Brave (SysPulse cache limit)\n'
            'Comment=Separate launcher; close other Brave instances first\n'
            f'Exec={exe} --disk-cache-size={cap(mib)*1048576} %U\n'
            'Icon=brave-browser\nTerminal=false\nCategories=Network;WebBrowser;\n')

def directory(home):
    p = home
    for part in ('', '.local', 'share', 'applications'):
        if part:
            p = p / part
            p.mkdir(mode=0o700, exist_ok=True)
        s = p.lstat()
        if not stat.S_ISDIR(s.st_mode) or s.st_uid != os.getuid() or s.st_mode & 0o022:
            raise ValueError('Unsafe launcher directory: '+str(p))
    return p

def read(p):
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError: return None
    with os.fdopen(fd, 'rb') as f:
        s = os.fstat(f.fileno())
        if not stat.S_ISREG(s.st_mode) or s.st_uid != os.getuid() or s.st_nlink != 1 or s.st_mode & 0o022 or s.st_size > 4096:
            raise ValueError('Unsafe existing launcher')
        data = f.read(4097).decode('utf-8')
    for exe in EXES:
        m = re.search(r'--disk-cache-size=([0-9]+) %U\n', data)
        if m:
            n = int(m[1]); mib, rem = divmod(n,1048576)
            if not rem and 64 <= mib <= 2048 and data == contents(exe,mib): return (exe,mib)
    raise ValueError('Existing launcher is not an unmodified SysPulse launcher; nothing overwritten')

def change(home, action, exe=None, mib=None):
    p = directory(home) / NAME
    previous = read(p)
    if action == 'status': return 'OFF' if previous is None else f'ON {previous[1]} MiB'
    if action == 'remove':
        if previous is not None: p.unlink()
        return 'OFF'
    if action != 'set': raise ValueError('Unexpected action')
    data = contents(exe,mib)
    fd, tmp = tempfile.mkstemp(prefix='.syspulse-brave-',dir=p.parent)
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            f.write(data); f.flush(); os.fsync(f.fileno())
        if read(p) != previous: raise ValueError('Launcher changed during operation')
        os.replace(tmp,p)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
    if read(p) != (exe,int(mib)): raise RuntimeError('Launcher readback failed')
    return f'ON {mib} MiB'

def trusted():
    for exe in EXES:
        try:
            target=Path(exe).resolve(strict=True)
            if not target.is_file() or not os.access(target,os.X_OK): continue
            if all(p.stat().st_uid==0 and not p.stat().st_mode & 0o022 for p in (target,*target.parents)):
                return exe
        except OSError: pass
    raise ValueError('Trusted Brave executable not installed')

class Tests(unittest.TestCase):
    def setUp(self): self.tmp=tempfile.TemporaryDirectory(); self.home=Path(self.tmp.name)
    def tearDown(self): self.tmp.cleanup()
    def test_lifecycle(self):
        self.assertEqual(change(self.home,'status'),'OFF')
        for n in (64,256,2048):
            self.assertEqual(change(self.home,'set',EXES[0],n),f'ON {n} MiB')
            self.assertEqual(change(self.home,'status'),f'ON {n} MiB')
        self.assertEqual(change(self.home,'remove'),'OFF'); self.assertEqual(change(self.home,'remove'),'OFF')
    def test_invalid(self):
        for n in ('-1','0','63','2049','1;id','01','256\n',True):
            with self.subTest(n=n),self.assertRaises(ValueError): cap(n)
    def test_unmanaged(self):
        p=directory(self.home)/NAME; p.write_text('user custom')
        for a in ('set','remove'):
            with self.assertRaises(ValueError): change(self.home,a,EXES[0],256)
        self.assertEqual(p.read_text(),'user custom')
    def test_symlink(self):
        p=directory(self.home)/NAME; target=self.home/'target';target.write_text('safe');p.symlink_to(target)
        with self.assertRaises(OSError): change(self.home,'set',EXES[0],256)
        self.assertEqual(target.read_text(),'safe')
    def test_hardlink(self):
        p=directory(self.home)/NAME;p.write_text(contents(EXES[0],64));os.link(p,self.home/'other')
        with self.assertRaises(ValueError): change(self.home,'remove')
    def test_dir_symlink(self):
        (self.home/'.local').symlink_to('/tmp')
        with self.assertRaises(ValueError): directory(self.home)
    def test_writable(self):
        p=directory(self.home)/NAME;p.write_text(contents(EXES[0],64));p.chmod(0o666)
        with self.assertRaises(ValueError): change(self.home,'remove')
    def test_executable(self):
        with self.assertRaises(ValueError): contents('/tmp/brave',256)

if __name__=='__main__':
    if sys.argv[1:]==['--self-test']: unittest.main(argv=[sys.argv[0]])
    try:
        if os.geteuid()==0: raise ValueError('Run as the desktop user, not root')
        args=sys.argv[1:]
        if args in (['status'],['remove']): print(change(Path.home(),args[0]))
        elif len(args)==2 and args[0]=='set': print(change(Path.home(),'set',trusted(),cap(args[1])))
        else: raise ValueError('Use status, set MIB, or remove')
    except (OSError,ValueError,RuntimeError) as e: print('ERROR: '+str(e),file=sys.stderr);sys.exit(1)
