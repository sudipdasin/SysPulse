FROM ubuntu:24.04 AS test
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 git gnupg dpkg-dev ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 signer && mkdir -p /src /state /out && chown signer:signer /state /out && chmod 0700 /state
COPY tools/release/source_signer.py /src/tools/release/source_signer.py
COPY assets/update-trust/alpha-public.gpg.b64 /src/assets/update-trust/alpha-public.gpg.b64
USER signer
RUN python3 /src/tools/release/source_signer.py self-test > /out/SELF-TEST.txt 2>&1 && cat /out/SELF-TEST.txt
RUN python3 /src/tools/release/source_signer.py verify --state /state > /out/FEED-VERIFY.txt && cat /out/FEED-VERIFY.txt
RUN if python3 /src/tools/release/source_signer.py publish --state /state > /out/REFUSAL.txt 2>&1; then exit 1; fi && grep -F 'Protected independent validator approval required' /out/REFUSAL.txt && cat /out/REFUSAL.txt

# Supplementary exact-byte upgrade validation; no new compilation.
FROM ubuntu:24.04 AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates gnupg dpkg-dev && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 tester && mkdir -p /check /upgrade && chown tester:tester /check /upgrade
COPY assets/update-trust/alpha-public.gpg.b64 /tmp/owner.b64
COPY tools/render/make-upgrade-fixture.sh /tmp/make-fixture.sh
USER tester
WORKDIR /check
RUN base64 -d /tmp/owner.b64 > owner.gpg && echo '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6  owner.gpg' | sha256sum -c -
RUN python3 -c 'import urllib.request,pathlib,hashlib; base="https://raw.githubusercontent.com/sudipdasin/SysPulse/edd83a288c17e66a484c8ecd3674b694e5314a9b/"; files={"Release":8192,"InRelease":16384,"Release.gpg":8192,"Packages":65536,"pool/syspulse-3.0.0-alpha.32_amd64.deb":1274144}; exec("for name,limit in files.items():\n r=urllib.request.urlopen(base+name,timeout=45); assert r.geturl()==base+name; b=r.read(limit+1); assert len(b)<=limit; pathlib.Path(name.split(\"/\")[-1]).write_bytes(b)")' \
    && gpgv --keyring /check/owner.gpg --output /check/clear /check/InRelease && cmp /check/Release /check/clear \
    && gpgv --keyring /check/owner.gpg /check/Release.gpg /check/Release \
    && python3 -c 'import pathlib,re,hashlib; r=pathlib.Path("Release").read_text(); b=pathlib.Path("Packages").read_bytes(); m=re.search(r"SHA256:\n ([0-9a-f]{64}) ([0-9]+) Packages",r); assert m and m[1]==hashlib.sha256(b).hexdigest() and int(m[2])==len(b); assert b"Version: 3.0.0~alpha32~render1" in b and b"SHA256: 4ad1349a6c369aa211d80b873074082f5d50bd29934e07f1c55221e34d54babc" in b' \
    && echo '4ad1349a6c369aa211d80b873074082f5d50bd29934e07f1c55221e34d54babc  syspulse-3.0.0-alpha.32_amd64.deb' | sha256sum -c - \
    && test "$(dpkg-deb -f syspulse-3.0.0-alpha.32_amd64.deb Version)" = '3.0.0~alpha32~render1'
RUN python3 -c 'import urllib.request,pathlib,hashlib; u="https://syspulse-alpha33-profile-eval.onrender.com/syspulse-3.0.0-alpha.33-x86_64-ubuntu-22.04-render-eval.deb"; r=urllib.request.urlopen(u,timeout=60); assert r.geturl()==u; b=r.read(16777217); assert len(b)<=16777216 and hashlib.sha256(b).hexdigest()=="0ee1a08fd6c148b4e5396435eea03972674e7bbee9ac174d5a6cd0200e459ae8"; pathlib.Path("alpha33.deb").write_bytes(b)' \
    && bash /tmp/make-fixture.sh /check/alpha33.deb /upgrade
FROM ubuntu:24.04 AS installcheck
COPY --from=fetch /check/syspulse-3.0.0-alpha.32_amd64.deb /tmp/prior.deb
COPY --from=fetch /check/alpha33.deb /tmp/candidate.deb
COPY --from=fetch --chown=0:0 /upgrade/ /upgrade/
COPY tools/render/test-apt-updater-runtime.py /tmp/test-updater.py
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove --no-install-recommends /tmp/prior.deb python3 ca-certificates pkexec fonts-dejavu-core xvfb xauth dbus-x11 xinput x11-xserver-utils xfconf xfce4-settings procps iproute2 util-linux \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' && useradd --create-home --uid 10001 tester
USER tester
ENV HOME=/home/tester QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/home/tester/runtime
RUN mkdir -m 700 "$XDG_RUNTIME_DIR" && mkdir -p "$HOME/.config/SysPulse" && printf '[General]\nupgradeFixture=preserve-user-settings\n' > "$HOME/.config/SysPulse/SysPulse.ini" && sha256sum "$HOME/.config/SysPulse/SysPulse.ini" > "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.32' && (rc=0; timeout 4s syspulse >/tmp/prior-launch.log 2>&1 || rc=$?; test "$rc" = 124)
USER root
ENV HOME=/root
RUN printf 'deb [arch=amd64 signed-by=/upgrade/test-only.gpg] file:/upgrade/repo ./\n' > /tmp/syspulse-upgrade.list \
    && apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update \
    && printf 'tampered\n' >> /upgrade/repo/pool/syspulse_3.0.0~alpha33~render1_amd64.deb \
    && (if apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade syspulse=3.0.0~alpha33~render1 >/tmp/tamper.log 2>&1; then exit 1; fi; grep -Ei 'hash sum mismatch|file has unexpected size|size mismatch' /tmp/tamper.log) \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' \
    && cp /tmp/candidate.deb /upgrade/repo/pool/syspulse_3.0.0~alpha33~render1_amd64.deb \
    && dpkg-deb -x /tmp/candidate.deb /tmp/updater-test \
    && python3 /tmp/test-updater.py /tmp/updater-test/usr/bin/syspulse-apt-update \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha33~render1'
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.33' && (rc=0; timeout 4s syspulse >/tmp/new-launch.log 2>&1 || rc=$?; test "$rc" = 124) && sha256sum -c "$HOME/preference.sha256"
USER root
ENV HOME=/root
RUN apt-get install -y --no-remove --allow-downgrades --no-install-recommends /tmp/prior.deb && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' && apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade syspulse=3.0.0~alpha33~render1 && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha33~render1'
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.33' && test "$(sha256sum /usr/share/syspulse/update-keys/alpha.gpg | cut -d' ' -f1)" = '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6' && syspulse-apt-update check alpha | grep -Fx 'CURRENT 3.0.0~alpha33~render1' && printf 'Exact Alpha.32 signed prior package and unchanged Alpha.33 evaluation DEB verified by SHA-256. Actual APT tamper rejection, actual updater signed fixture upgrade, preferences, launch, pinned prior recovery, re-upgrade and owner public anchor readback passed. No production signing. This is supplementary exact-byte upgrade evidence, not a new build or full GUI regression.\n' > "$HOME/EXACT-UPGRADE.txt"

FROM ubuntu:24.04 AS diagnosticcheck
RUN apt-get update && apt-get install -y --no-install-recommends python3 systemd procps iproute2 util-linux && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 diagnostic && mkdir -p /out && chown diagnostic:diagnostic /out
COPY tools/syspulse-diagnostics /tmp/syspulse-diagnostics
COPY tools/render/test-diagnostic-learning-runtime.py /tmp/test-diagnostic-learning-runtime.py
USER diagnostic
RUN python3 /tmp/syspulse-diagnostics self-test > /out/DIAGNOSTICS-TEST.txt 2>&1 || { cat /out/DIAGNOSTICS-TEST.txt; exit 1; }
RUN cat /out/DIAGNOSTICS-TEST.txt
RUN python3 /tmp/test-diagnostic-learning-runtime.py /tmp/syspulse-diagnostics > /out/DIAGNOSTICS-RUNTIME.txt && cat /out/DIAGNOSTICS-RUNTIME.txt


# Alpha.34 full native candidate (old validation reports retained)
FROM ubuntu:22.04 AS dependencies
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake qtbase5-dev dpkg-dev desktop-file-utils python3 openssl gnupg file git \
    fonts-dejavu-core ca-certificates xdg-utils procps iproute2 util-linux dbus-x11 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 builder && mkdir -p /src /work /out /upgrade /oldsrc /oldwork /oldout && chown builder:builder /src /work /out /upgrade /oldsrc /oldwork /oldout
FROM dependencies AS build34
COPY --chown=builder:builder CMakeLists.txt LICENSE PRIVACY.md /src/
COPY --chown=builder:builder include/ /src/include/
COPY --chown=builder:builder src/ /src/src/
COPY --chown=builder:builder tests/ /src/tests/
COPY --chown=builder:builder assets/ /src/assets/
COPY --chown=builder:builder docs/SYSPULSE_MILESTONE.md docs/BETA_READINESS.md /src/docs/
COPY --chown=builder:builder tools/ /src/tools/
USER builder
RUN bash /src/tools/render/build-alpha34.sh /src /work /out
RUN bash /src/tools/render/make-alpha34-upgrade-fixture.sh /out/syspulse-3.0.0-alpha.34-x86_64-ubuntu-22.04-render-eval.deb /upgrade
FROM ubuntu:24.04 AS installcheck34
COPY --from=fetch /check/syspulse-3.0.0-alpha.32_amd64.deb /previous/previous.deb
COPY --from=build34 /out/ /candidate/
COPY --from=build34 --chown=0:0 /upgrade/ /upgrade/
COPY --from=build34 /work/build/syspulse-cleaner-ui-tests /usr/local/bin/syspulse-cleaner-runtime-test
COPY --from=build34 /work/build/syspulse-cleaner-tests /usr/local/bin/syspulse-cleaner-core-runtime-test
COPY tools/render/test-volume-runtime.py /usr/local/bin/syspulse-volume-runtime-test.py
COPY tools/render/test-alpha34-admin-session-runtime.py /usr/local/bin/syspulse-admin-session-runtime-test.py
COPY --from=build34 /work/build/tux-tests /usr/local/bin/syspulse-core-runtime-test
COPY --from=build34 /work/build/syspulse-shell-tests /usr/local/bin/syspulse-shell-runtime-test
COPY tools/render/x11-runtime-test.sh /usr/local/bin/syspulse-x11-runtime-test.sh
COPY tools/render/test-alpha34-apt-updater-runtime.py /usr/local/bin/syspulse-apt-updater-runtime-test.py
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove --no-install-recommends /previous/previous.deb python3 ca-certificates pkexec fonts-dejavu-core xvfb xauth dbus-x11 xinput x11-xserver-utils xfconf xfce4-settings procps iproute2 util-linux \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' \
    && useradd --create-home --uid 10001 tester
USER tester
ENV HOME=/home/tester QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/home/tester/runtime
RUN mkdir -m 700 "$XDG_RUNTIME_DIR" \
    && mkdir -p "$HOME/.config/SysPulse" \
    && printf '[updates]\nautomaticCachedCheck=true\n[General]\nupgradeFixture=preserve-user-settings\n' > "$HOME/.config/SysPulse/SysPulse.ini" \
    && sha256sum "$HOME/.config/SysPulse/SysPulse.ini" > "$HOME/preference.sha256" \
    && syspulse --version | grep -F '3.0.0-alpha.32' \
    && (rc=0; timeout 4s syspulse >/tmp/prior-launch.log 2>&1 || rc=$?; test "$rc" = 124)
USER root
ENV HOME=/root
RUN printf 'deb [arch=amd64 signed-by=/upgrade/test-only.gpg] file:/upgrade/repo ./\n' > /tmp/syspulse-upgrade.list \
    && apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 -o Acquire::Languages=none update \
    && apt-cache -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- policy syspulse | grep -F 'Candidate: 3.0.0~alpha34~render1' \
    && printf 'corruption-fixture\n' >> /upgrade/repo/pool/syspulse_3.0.0~alpha34~render1_amd64.deb \
    && (if DEBIAN_FRONTEND=noninteractive apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade --no-install-recommends syspulse=3.0.0~alpha34~render1 >/tmp/tamper.log 2>&1; then echo 'Tampered package unexpectedly accepted'; exit 1; fi; (grep -Ei 'hash sum mismatch|file has unexpected size|size mismatch' /tmp/tamper.log || { cat /tmp/tamper.log; exit 1; })) \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' \
    && cp /candidate/*.deb /upgrade/repo/pool/syspulse_3.0.0~alpha34~render1_amd64.deb \
    && dpkg-deb -x /candidate/*.deb /tmp/updater-test \
    && python3 /usr/local/bin/syspulse-apt-updater-runtime-test.py /tmp/updater-test/usr/bin/syspulse-apt-update \
    && rm -rf /tmp/updater-test \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha34~render1' \
    && test "$(stat -c '%u:%g:%a' /usr/bin/syspulse-memory-control)" = '0:0:755' \
    && test "$(stat -c '%u:%g:%a' /usr/bin/syspulse-volume-scan)" = '0:0:755' \
    && python3 /usr/local/bin/syspulse-volume-runtime-test.py \
    && test "$(stat -c '%u:%g:%a' /usr/bin/syspulse-admin-session)" = '0:0:755' \
    && python3 /usr/local/bin/syspulse-admin-session-runtime-test.py
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" \
    && syspulse --version | grep -F '3.0.0-alpha.34' \
    && (rc=0; timeout 4s syspulse >/tmp/upgraded-launch.log 2>&1 || rc=$?; test "$rc" = 124) \
    && sha256sum -c "$HOME/preference.sha256"
USER root
ENV HOME=/root
# Explicit downgrade only in the disposable test container, to the pinned prior package.
# This is a recovery test, not a production automatic rollback policy.
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove --allow-downgrades --no-install-recommends /previous/previous.deb \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1'
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" \
    && syspulse --version | grep -F '3.0.0-alpha.32' \
    && (rc=0; timeout 4s syspulse >/tmp/recovered-launch.log 2>&1 || rc=$?; test "$rc" = 124)
USER root
ENV HOME=/root
RUN DEBIAN_FRONTEND=noninteractive apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade --no-install-recommends syspulse=3.0.0~alpha34~render1 \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha34~render1'
RUN DEBIAN_FRONTEND=noninteractive apt-get remove -y syspulse \
    && test ! -e /usr/bin/syspulse && test ! -e /usr/bin/syspulse-memory-control \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove --no-install-recommends /candidate/*.deb \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha34~render1' \
    && test "$(stat -c '%u:%g:%a' /usr/bin/syspulse-memory-control)" = '0:0:755' \
    && rm -rf /var/lib/apt/lists/*
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" \
    && syspulse --version | grep -F '3.0.0-alpha.34' \
    && tux-steward --version | grep -F '3.0.0-alpha.34' \
    && tux-task-manager --version | grep -F '3.0.0-alpha.34' \
    && tux-setup --version | grep -F '3.0.0-alpha.34' \
    && syspulse --help >/dev/null \
    && test "$(sha256sum /usr/share/syspulse/update-keys/alpha.gpg | cut -d' ' -f1)" = '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6' \
    && test "$(cat /usr/share/syspulse/update-keys/alpha.sha256)" = '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6' \
    && python3 -c 'import runpy; u=runpy.run_path("/usr/bin/syspulse-apt-update"); assert u["secure_key"](u["resolve_key"]("alpha"))' \
    && (rc=0; syspulse-admin-session </dev/null >/dev/null 2>&1 || rc=$?; test "$rc" = 1) \
    && syspulse-apt-update check alpha | grep -Fx 'CURRENT 3.0.0~alpha34~render1' \
    && /usr/bin/syspulse-input-control --self-test \
    && /usr/bin/syspulse-brave-profile --self-test \
    && /usr/bin/syspulse-desktop-recovery --self-test \
    && /usr/bin/syspulse-schedule-profile --self-test \
    && /usr/bin/syspulse-hdd-profile --self-test \
    && /usr/bin/syspulse-desktop-profile --self-test \
    && test "$(stat -c '%u:%g:%a' /usr/bin/syspulse-diagnostics)" = '0:0:755' \
    && /usr/bin/syspulse-diagnostics self-test \
    && timeout 200s env SYSPULSE_DIAGNOSTICS_RUNTIME=1 /usr/local/bin/syspulse-shell-runtime-test \
    && test -f /usr/lib/systemd/system/syspulse-daily-clean.timer \
    && test -f /usr/lib/systemd/system/syspulse-monthly-clean.timer \
    && test -f /usr/lib/systemd/system/syspulse-weekly-clean.timer \
    && timeout 20s /usr/local/bin/syspulse-cleaner-core-runtime-test \
    && timeout 40s /usr/local/bin/syspulse-cleaner-runtime-test \
    && (rc=0; syspulse-volume-scan / standard >/tmp/volume-guard.log 2>&1 || rc=$?; test "$rc" = 1 && grep -F 'Administrator authorization required' /tmp/volume-guard.log) \
    && timeout 90s bash /usr/local/bin/syspulse-x11-runtime-test.sh \
    && (rc=0; syspulse-memory-control enable >/tmp/helper-guard.log 2>&1 || rc=$?; test "$rc" = 1 && grep -F 'Administrator authorization required' /tmp/helper-guard.log) \
    && (rc=0; timeout 4s syspulse >/tmp/reinstalled-launch.log 2>&1 || rc=$?; test "$rc" = 124) \
    && printf 'Ubuntu 24.04 amd64: exact canonical signed prior alpha.32 package verified by SHA-256; real APT installation, tampered package rejection with prior version retained, signed local repository upgrade to alpha.34 through the actual new updater helper, explicit pinned prior-package recovery and signed re-upgrade, preference checksum preservation, remove/reinstall, all four versions, helper ownership and non-root refusal, two actual cache cleanups and protected volume inspection on one administrator broker connection, current-version install refusal through broker, typed request rejection, EOF revocation and unknown request rejection, verified owner public anchor in the installed package, unprivileged offscreen startup, Cleaner GUI functional regression on Ubuntu 24.04 runtime, virtual X11 GUI shell including single startup-window check, actual root read-only volume metadata scan, non-root refusal and real X11 diagnostics, and isolated XFCE compositor setting readback passed. Actual installed Analyze-to-Boost GUI workflow with own-process memory only and receipt passed. Disposable signing fixture for Alpha.33 upgrade; owner public key packaged and real Alpha.27 online discovery checked with no downgrade. Prior Alpha.27 owner publication verified; Alpha.33 owner publication, physical Mint XFCE authorization and successive online upgrade remain pending.\n' > /home/tester/INSTALL-STATUS.txt

FROM ubuntu:24.04 AS hybrid36
RUN apt-get update && apt-get install -y --no-install-recommends python3 procps util-linux systemd iproute2 smartmontools ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 hybrid && mkdir -p /out /usr/share/syspulse-fixtures/cleaners && chown hybrid:hybrid /out
RUN printf '%s' '<cleaner id="fixture"><option id="cache"><action command="delete" search="file" path="/never-execute"/></option><option id="passwords"/></cleaner>' > /usr/share/syspulse-fixtures/cleaners/fixture.xml && printf '%s' '<!DOCTYPE cleaner [<!ENTITY test SYSTEM "file:///etc/passwd">]><cleaner id="unsafe"><option id="cache"/></cleaner>' > /usr/share/syspulse-fixtures/cleaners/unsafe.xml && ln -s /etc/passwd /usr/share/syspulse-fixtures/cleaners/link.xml
COPY hybrid36/tools/ /src/tools/
COPY hybrid36/tests/ /src/tests/
USER hybrid
RUN python3 /src/tests/test_hybrid_engine.py > /out/HYBRID36-TESTS.txt 2>&1 || { cat /out/HYBRID36-TESTS.txt; exit 1; }
RUN python3 /src/tools/syspulse-diagnostics self-test > /out/HYBRID36-DB-TESTS.txt 2>&1 || { cat /out/HYBRID36-DB-TESTS.txt; exit 1; }
RUN python3 /src/tests/test_research_adapters.py > /out/HYBRID36-RESEARCH-TESTS.txt 2>&1 || { cat /out/HYBRID36-RESEARCH-TESTS.txt; exit 1; }
RUN cat /out/HYBRID36-TESTS.txt /out/HYBRID36-DB-TESTS.txt /out/HYBRID36-RESEARCH-TESTS.txt
RUN smartctl --version > /out/HYBRID36-SMART-VERSION.txt && python3 /src/tools/syspulse-diagnostics analyze > /out/HYBRID36-SMOKE-PRIVATE.json && python3 -c 'import json,pathlib; p=pathlib.Path("/out/HYBRID36-SMOKE-PRIVATE.json"); a=json.loads(p.read_text()); assert a["state"]=="ready"; s=next(x for x in a["sources"] if x["name"]=="smart-disk-health"); print("Real non-root analysis completed; SMART coverage: "+s["status"]+"; "+str(len(a["sources"]))+" source checks; masked patterns and local recipes present; no disk mutations"); assert "patterns" in a and "recipes" in a and "cleaner_catalog" in a; p.unlink()' > /out/HYBRID36-SMOKE.txt && cat /out/HYBRID36-SMOKE.txt

FROM python:3.11-slim-bookworm
COPY --from=test /out/ /srv/results/
COPY --from=hybrid36 /out/ /srv/results/
COPY --from=diagnosticcheck /out/ /srv/results/
COPY --from=installcheck /home/tester/EXACT-UPGRADE.txt /srv/results/
COPY --from=build34 /out/ /srv/results/alpha34/
COPY --from=installcheck34 /home/tester/INSTALL-STATUS.txt /srv/results/alpha34/INSTALL-STATUS.txt
USER 10001:10001
EXPOSE 10000
CMD ["python3","-m","http.server","10000","--bind","0.0.0.0","--directory","/srv/results/"]
