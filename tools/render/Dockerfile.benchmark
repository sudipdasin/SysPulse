FROM ubuntu:22.04 AS benchmark
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake qtbase5-dev dpkg-dev desktop-file-utils python3 openssl gnupg file git \
    fonts-dejavu-core ca-certificates xdg-utils procps iproute2 util-linux dbus-x11 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 builder && mkdir -p /src /work /out && chown builder:builder /src /work /out
COPY --chown=builder:builder CMakeLists.txt LICENSE PRIVACY.md /src/
COPY --chown=builder:builder include/ /src/include/
COPY --chown=builder:builder src/ /src/src/
COPY --chown=builder:builder tests/ /src/tests/
COPY --chown=builder:builder assets/ /src/assets/
COPY --chown=builder:builder docs/SYSPULSE_MILESTONE.md docs/BETA_READINESS.md /src/docs/
COPY --chown=builder:builder tools/ /src/tools/
USER builder
RUN cmake -S /src -B /work/build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DSYSPULSE_PACKAGE_TARGET=ubuntu-22.04 -DSYSPULSE_USE_OWNER_ALPHA_TRUST=ON -DSYSPULSE_REPORT_ENDPOINT=https://syspulse-diagnostic-relay.onrender.com/diagnostics/v1/report \
    && cmake --build /work/build --parallel 2 --target syspulse-idle-probe \
    && g++ -O2 -std=c++17 -Wall -Wextra -I/src/include /src/tests/benchmark_cleaner.cpp -o /work/cleaner-probe \
    && dbus-run-session -- python3 /src/tools/render/benchmark-native.py /work/build/syspulse-idle-probe /work/cleaner-probe 1dd50ad48ab08d4f90358690ad8c7864d7185d75 /out/BENCHMARK.json
FROM python:3.11-slim-bookworm
COPY --from=benchmark /out/ /srv/artifacts/
USER 10001:10001
EXPOSE 10000
CMD ["python3","-m","http.server","10000","--bind","0.0.0.0","--directory","/srv/artifacts/"]
