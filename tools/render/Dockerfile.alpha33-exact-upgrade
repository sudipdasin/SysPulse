FROM ubuntu:24.04 AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates gnupg dpkg-dev && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 tester && mkdir -p /check /upgrade && chown tester:tester /check /upgrade
COPY assets/update-trust/alpha-public.gpg.b64 /tmp/owner.b64
COPY tools/render/make-upgrade-fixture.sh /tmp/make-fixture.sh
USER tester
WORKDIR /check
RUN base64 -d /tmp/owner.b64 > owner.gpg && echo '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6  owner.gpg' | sha256sum -c -
RUN python3 -c 'import urllib.request,pathlib,hashlib; base="https://raw.githubusercontent.com/sudipdasin/SysPulse/edd83a288c17e66a484c8ecd3674b694e5314a9b/"; files={"Release":8192,"InRelease":16384,"Release.gpg":8192,"Packages":65536,"pool/syspulse-3.0.0-alpha.32_amd64.deb":1274144}; exec("for name,limit in files.items():\n r=urllib.request.urlopen(base+name,timeout=45); assert r.geturl()==base+name; b=r.read(limit+1); assert len(b)<=limit; pathlib.Path(name.split(\"/\")[-1]).write_bytes(b)")' \
    && gpgv --keyring /check/owner.gpg --output /check/clear /check/InRelease && cmp /check/Release /check/clear \
    && gpgv --keyring /check/owner.gpg /check/Release.gpg /check/Release \
    && python3 -c 'import pathlib,re,hashlib; r=pathlib.Path("Release").read_text(); b=pathlib.Path("Packages").read_bytes(); m=re.search(r"SHA256:\\n ([0-9a-f]{64}) ([0-9]+) Packages",r); assert m and m[1]==hashlib.sha256(b).hexdigest() and int(m[2])==len(b); assert b"Version: 3.0.0~alpha32~render1" in b and b"SHA256: 4ad1349a6c369aa211d80b873074082f5d50bd29934e07f1c55221e34d54babc" in b' \
    && echo '4ad1349a6c369aa211d80b873074082f5d50bd29934e07f1c55221e34d54babc  syspulse-3.0.0-alpha.32_amd64.deb' | sha256sum -c - \
    && test "$(dpkg-deb -f syspulse-3.0.0-alpha.32_amd64.deb Version)" = '3.0.0~alpha32~render1'
RUN python3 -c 'import urllib.request,pathlib,hashlib; u="https://syspulse-alpha33-profile-eval.onrender.com/syspulse-3.0.0-alpha.33-x86_64-ubuntu-22.04-render-eval.deb"; r=urllib.request.urlopen(u,timeout=60); assert r.geturl()==u; b=r.read(16777217); assert len(b)<=16777216 and hashlib.sha256(b).hexdigest()=="0ee1a08fd6c148b4e5396435eea03972674e7bbee9ac174d5a6cd0200e459ae8"; pathlib.Path("alpha33.deb").write_bytes(b)' \
    && bash /tmp/make-fixture.sh /check/alpha33.deb /upgrade
FROM ubuntu:24.04 AS installcheck
COPY --from=fetch /check/syspulse-3.0.0-alpha.32_amd64.deb /tmp/prior.deb
COPY --from=fetch /check/alpha33.deb /tmp/candidate.deb
COPY --from=fetch --chown=0:0 /upgrade/ /upgrade/
COPY tools/render/test-apt-updater-runtime.py /tmp/test-updater.py
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove --no-install-recommends /tmp/prior.deb python3 ca-certificates pkexec fonts-dejavu-core xvfb xauth dbus-x11 xinput x11-xserver-utils xfconf xfce4-settings procps iproute2 util-linux \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' && useradd --create-home --uid 10001 tester
USER tester
ENV HOME=/home/tester QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/home/tester/runtime
RUN mkdir -m 700 "$XDG_RUNTIME_DIR" && mkdir -p "$HOME/.config/SysPulse" && printf '[General]\nupgradeFixture=preserve-user-settings\n' > "$HOME/.config/SysPulse/SysPulse.ini" && sha256sum "$HOME/.config/SysPulse/SysPulse.ini" > "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.32' && (rc=0; timeout 4s syspulse >/tmp/prior-launch.log 2>&1 || rc=$?; test "$rc" = 124)
USER root
ENV HOME=/root
RUN printf 'deb [arch=amd64 signed-by=/upgrade/test-only.gpg] file:/upgrade/repo ./\n' > /tmp/syspulse-upgrade.list \
    && apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update \
    && printf 'tampered\n' >> /upgrade/repo/pool/syspulse_3.0.0~alpha33~render1_amd64.deb \
    && (if apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade syspulse=3.0.0~alpha33~render1 >/tmp/tamper.log 2>&1; then exit 1; fi; grep -Ei 'hash sum mismatch|file has unexpected size|size mismatch' /tmp/tamper.log) \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' \
    && cp /tmp/candidate.deb /upgrade/repo/pool/syspulse_3.0.0~alpha33~render1_amd64.deb \
    && dpkg-deb -x /tmp/candidate.deb /tmp/updater-test \
    && python3 /tmp/test-updater.py /tmp/updater-test/usr/bin/syspulse-apt-update \
    && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha33~render1'
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.33' && (rc=0; timeout 4s syspulse >/tmp/new-launch.log 2>&1 || rc=$?; test "$rc" = 124) && sha256sum -c "$HOME/preference.sha256"
USER root
ENV HOME=/root
RUN apt-get install -y --no-remove --allow-downgrades --no-install-recommends /tmp/prior.deb && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha32~render1' && apt-get -o Dir::Etc::sourcelist=/tmp/syspulse-upgrade.list -o Dir::Etc::sourceparts=- install -y --no-remove --only-upgrade syspulse=3.0.0~alpha33~render1 && test "$(dpkg-query -W -f='${Version}' syspulse)" = '3.0.0~alpha33~render1'
USER tester
ENV HOME=/home/tester
RUN sha256sum -c "$HOME/preference.sha256" && syspulse --version | grep -F '3.0.0-alpha.33' && test "$(sha256sum /usr/share/syspulse/update-keys/alpha.gpg | cut -d' ' -f1)" = '1d16b08d5bf50ba03cd8f294a94ef7f5259f9c5f4795a39134e9fde4b5968dc6' && syspulse-apt-update check alpha | grep -Fx 'CURRENT 3.0.0~alpha33~render1' && printf 'Exact Alpha.32 signed prior package and unchanged Alpha.33 evaluation DEB verified by SHA-256. Actual APT tamper rejection, actual updater signed fixture upgrade, preferences, launch, pinned prior recovery, re-upgrade and owner public anchor readback passed. No production signing. This is supplementary exact-byte upgrade evidence, not a new build or full GUI regression.\n' > "$HOME/EXACT-UPGRADE.txt"
FROM python:3.11-slim-bookworm
COPY --from=installcheck /home/tester/EXACT-UPGRADE.txt /srv/results/
USER 10001:10001
EXPOSE 10000
CMD ["python3","-m","http.server","10000","--bind","0.0.0.0","--directory","/srv/results/"]
