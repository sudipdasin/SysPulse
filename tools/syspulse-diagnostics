        c.execute("BEGIN IMMEDIATE")
        row=c.execute("SELECT analysis.state,boost.selected,boost.owner_pid,boost.owner_start FROM boost JOIN analysis USING(id) WHERE id=?",(ident,)).fetchone()
        require(row and row[0]=="reserved" and tuple(row[2:])==owner and set(json.loads(row[1]))==set(outcome),"Receipt does not match reserved actions")
