RULES=[(k,re.compile(v,re.I)) for k,v in PATTERNS]
def require(ok,msg):
    if not ok:raise ValueError(msg)
def boot_id():
    s=P("/proc/sys/kernel/random/boot_id").read_text().strip()
    require(re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",s),"Boot identity unavailable")
    return s
def clock():return time.clock_gettime(time.CLOCK_BOOTTIME)
def process_start(pid):
    try:
        raw=P(f"/proc/{pid}/stat").read_text();return raw.rsplit(")",1)[1].split()[19]
    except (OSError,IndexError):return None
def caller():
    pid=os.getppid();stamp=process_start(pid);require(stamp is not None,"Caller identity unavailable");return pid,stamp
def bounded_file(path,tail=False,limit=MAX_READ):
    # No follows, special files, blocking FIFO or unbounded reads.
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,"rb") as f:
        s=os.fstat(f.fileno());require(stat.S_ISREG(s.st_mode),"Not a regular diagnostic source")
        if tail and s.st_size>limit:
            f.seek(s.st_size-limit);data=f.read(limit+1)
            data=data.partition(b"\n")[2]
            return data[:limit].decode("utf-8","replace"),True
        data=f.read(limit+1);return data[:limit].decode("utf-8","replace"),len(data)>limit
def command(args,timeout=7,limit=MAX_READ):
    # Absolute executable from fixed trusted system directories. Never use user PATH.
    name=args[0]
    exe=next((str(P(d)/name) for d in ("/usr/bin","/usr/sbin","/bin","/sbin") if (P(d)/name).is_file() and os.access(P(d)/name,os.X_OK)),None)
    if not exe:return "unavailable","",False
    env={"PATH":"/usr/bin:/usr/sbin:/bin:/sbin","HOME":str(P.home()),"LANG":"C","LC_ALL":"C","SYSTEMD_PAGER":"","SYSTEMD_COLORS":"0","PAGER":"cat"}
    # Preserve only session bus address for read-only user journal/services.
    if os.environ.get("XDG_RUNTIME_DIR")=="/run/user/"+str(os.getuid()):
        env["XDG_RUNTIME_DIR"]=os.environ["XDG_RUNTIME_DIR"]
        env["DBUS_SESSION_BUS_ADDRESS"]="unix:path="+env["XDG_RUNTIME_DIR"]+"/bus"
    p=subprocess.Popen([exe,*args[1:]],env=env,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,start_new_session=True)
    out=bytearray();status="ok";truncated=False;deadline=time.monotonic()+timeout
    try:
        with selectors.DefaultSelector() as sel:
            sel.register(p.stdout,selectors.EVENT_READ)
            while True:
                remaining=deadline-time.monotonic()
                if remaining<=0:status="timeout";break
                events=sel.select(remaining)
                if not events:status="timeout";break
                data=os.read(p.stdout.fileno(),16384)
                if not data:break
                room=limit-len(out);out.extend(data[:room])
                if len(data)>room:status="bounded";truncated=True;break
        if status=="ok":
            try:
                rc=p.wait(timeout=max(0.05,deadline-time.monotonic()))
                if rc:status="permission" if b"Permission denied" in out or b"Access denied" in out else "failed"
            except subprocess.TimeoutExpired:status="timeout"
    finally:
        if p.poll() is None:
            try:os.killpg(p.pid,signal.SIGKILL)
            except ProcessLookupError:pass
            p.wait()
        p.stdout.close()
    return status,out.decode("utf-8","replace"),truncated
def classify(line,priority=None):
    for key,rx in RULES:
        if rx.search(line):return key
    if priority is not None and priority<=3:return "other_error"
    return None
def event_counts(text,journal=False):
    counts={};total=0;bad=0;seen=set()
    for line in text.splitlines()[:MAX_LINES]:
        if not line.strip():continue
        total+=1
        if journal:
            try:
                row=json.loads(line);msg=row.get("MESSAGE","")
                if not isinstance(msg,str):bad+=1;continue
                pr=int(row.get("PRIORITY",7))
                cursor=row.get("__CURSOR")
                if isinstance(cursor,str):
                    if cursor in seen:continue
                    seen.add(cursor)
                key=classify(msg[:8192],pr)
            except (ValueError,TypeError,AttributeError):bad+=1;continue
        else:key=classify(line[:8192])
        if key:counts[key]=counts.get(key,0)+1
    return counts,total,bad,len(text.splitlines())>MAX_LINES
def source(name,status,counts=None,lines=0,bounded=False,notes=""):
    require(status in ("ok","empty","bounded","unavailable","permission","failed","timeout","partial"),"Invalid coverage status")
    return {"name":name,"status":status,"lines":int(lines),"bounded":bool(bounded),"events":counts or {},"note":notes}
def collect_job(spec):
    name,kind,args=spec
    try:
        if kind=="file":
            raw,limited=bounded_file(args[0],tail=True)
            status="bounded" if limited else "ok"
        elif kind=="gzip":
            fd=os.open(args[0],os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
            with os.fdopen(fd,"rb") as f:
                st=os.fstat(f.fileno());require(stat.S_ISREG(st.st_mode) and st.st_size<=MAX_READ,"Compressed source exceeds budget")
                with gzip.GzipFile(fileobj=f) as gz:data=gz.read(MAX_READ+1)
            limited=len(data)>MAX_READ;raw=data[:MAX_READ].decode("utf-8","replace");status="bounded" if limited else "ok"
        else:status,raw,limited=command(args,timeout=8)
        if kind=="journal":
            counts,lines,bad,more=event_counts(raw,True)
            if "not seeing messages from other users" in raw.lower() or "no journal files were opened due to insufficient permissions" in raw.lower():
                status="partial" if lines else "permission"
            if bad and status=="ok":status="partial"
            if more:limited=True;status="bounded"
            if name!="journal-user-7days" and not lines and status=="ok":
                # A quiet warning view is not necessarily unreadable: prove a current
                # kernel journal record is readable without the severity filter.
                if name=="kernel-journal-current-boot":
                    probe,raw_probe,_=command(["journalctl","-k","-b","-n","1","--no-pager","-o","json"],timeout=4,limit=32768)
                    try:visible=probe=="ok" and isinstance(json.loads(raw_probe.strip()),dict)
                    except (ValueError,TypeError):visible=False
                    status="empty" if visible else "partial"
                else:status="partial"
        elif kind=="services":
            lines=sum(1 for x in raw.splitlines() if x.strip())
            counts={"service_failure":lines} if lines and status=="ok" else {}
        elif kind=="audit":
            lines=sum(1 for x in raw.splitlines() if x.strip())
            counts={"package_failure":1} if lines and status=="ok" else {}
        elif kind=="crashes":
            lines=sum(1 for x in raw.splitlines() if x.strip())
            counts={"application_crash":lines} if lines and status=="ok" else {}
        elif kind=="inventory":
            lines=sum(1 for x in raw.splitlines() if x.strip());counts={}
        else:
            counts,lines,bad,more=event_counts(raw)
            if more:limited=True;status="bounded"
        if status=="ok" and not lines:status="empty"
        # Command failure itself is a coverage failure, not a fabricated system fault.
        if status in ("permission","failed","timeout","unavailable"):counts={}
        return source(name,status,counts,lines,limited,"Raw messages discarded; counts may overlap across sources.")
    except FileNotFoundError:return source(name,"unavailable")
    except PermissionError:return source(name,"permission")
    except (OSError,ValueError,subprocess.SubprocessError):return source(name,"failed")
