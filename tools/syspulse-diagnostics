def show_history(c):
    rows=[]
    for ident,utc,state,context,assessment in c.execute("SELECT id,utc,state,context,assessment FROM analysis ORDER BY utc DESC,rowid DESC LIMIT 30"):
        a=json.loads(assessment);rows.append({"id":ident,"utc":utc,"state":state,"context":context,"findings":len(a["findings"]),"coverage":a["coverage"],"research":bool(research_record(c,ident))})
