PATTERNS=[
 ("storage_io",r"\b(?:i/o error|buffer i/o|blk_update_request|ata[0-9].*failed command|nvme.*(?:timeout|reset|abort)|medium error|uncorrectable error)\b"),
 ("filesystem",r"(?:ext[234]-fs error|btrfs.*(?:error|corrupt)|xfs.*(?:corrupt|metadata error)|filesystem.*(?:corrupt|read-only)|remounting filesystem read-only)"),
 ("disk_health",r"(?:smart.*(?:fail|critical|bad)|pending sectors|reallocated sector.*(?:fail|critical)|critical warning.*(?:nvme|disk))"),
 ("oom",r"(?:out of memory|oom-kill|oom_reaper|killed process.*total-vm|systemd-oomd.*killed)"),
 ("memory_pressure",r"(?:memory pressure|swap.*(?:exhausted|full)|allocation failure)"),
 ("gpu",r"(?:gpu hang|gpu reset|amdgpu.*(?:fault|timeout|error)|i915.*(?:hang|error)|nvrm: xid|drm.*(?:error|failed))"),
 ("thermal",r"(?:critical temperature|thermal throttling|temperature above threshold|overheat)"),
 ("kernel_fault",r"(?:kernel panic|kernel bug|general protection fault|soft lockup|hard lockup|watchdog.*lockup|call trace:|machine check|hardware error)"),
 ("package_failure",r"(?:dpkg: error|unmet dependencies|sub-process.*returned an error|failed to fetch|package.*(?:broken|failed)|error processing package)"),
 ("authentication",r"(?:authentication failure|failed password|invalid user|pam_.*(?:failure|failed))"),
 ("network",r"(?:network.*(?:unreachable|failed|down)|dns.*(?:failure|timeout)|dhcp.*(?:fail|timeout)|connection timed out|link is down)"),
 ("application_crash",r"(?:segfault|segmentation fault|core dumped|coredump.*(?:crash|dumped)|fatal exception|aborted.*core)"),
 ("service_failure",r"(?:failed to start|failed with result|main process exited|dependency failed|start request repeated too quickly|unit .* failed)"),
 ("other_error",r"(?:\berror\b|\bfailed\b|\bfailure\b|\bcritical\b|\bpanic\b)"),
