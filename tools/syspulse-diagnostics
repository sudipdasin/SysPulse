def numeric_snapshot():
    def kv(path):
        try:
            raw,_=bounded_file(path,limit=65536);return {m[1]:int(m[2]) for line in raw.splitlines() if (m:=re.match(r"^([A-Za-z_()]+):?\s+([0-9]+)",line))}
        except (OSError,ValueError):return {}
    m=kv("/proc/meminfo");v=kv("/proc/vmstat");data={}
    for k,name in (("MemTotal","memory_total_kib"),("MemAvailable","memory_available_kib"),("SwapTotal","swap_total_kib"),("SwapFree","swap_free_kib")):
        if k in m:data[name]=m[k]
    for k in ("pswpin","pswpout","pgmajfault","oom_kill"):
        if k in v:data[k]=v[k]
    for name,path in (("root","/"),("home",str(P.home())),("apt","/var/cache/apt/archives")):
        try:
            s=os.statvfs(path)
            data[name+"_total_bytes"]=s.f_blocks*s.f_frsize;data[name+"_free_bytes"]=s.f_bavail*s.f_frsize
            data[name+"_readonly"]=bool(s.f_flag&os.ST_RDONLY)
            data[name+"_device"]=os.stat(path).st_dev
            if s.f_files:data[name+"_inode_free_pct"]=round(100*s.f_favail/s.f_files,2)
        except OSError:pass
    try:
        raw,_=bounded_file("/proc/loadavg",limit=4096);data["load1"]=float(raw.split()[0]);data["cpu_count"]=os.cpu_count() or 1
    except (OSError,ValueError,IndexError):pass
    for area in ("cpu","memory","io"):
        try:
            raw,_=bounded_file("/proc/pressure/"+area,limit=4096)
            for line in raw.splitlines():
                m=re.match(r"^(some|full) avg10=([0-9.]+)",line)
                if m:data[area+"_psi_"+m[1]]=float(m[2])
        except (OSError,ValueError):pass
    # Temperature measurements are advisory; no fan/clock changes.
    temps=[]
    for path in sorted(P("/sys/class/thermal").glob("thermal_zone*/temp"))[:64]:
        try:
            raw,_=bounded_file(path,limit=64);n=int(raw.strip())
            if 0<n<150000:temps.append(n/1000)
        except (OSError,ValueError):pass
    if temps:data["max_temperature_c"]=max(temps)
    # Aggregate inventory; no serials, MACs, network addresses or process names.
    for area,path in (("block_device_count","/sys/class/block"),("network_interface_count","/sys/class/net"),("power_supply_count","/sys/class/power_supply")):
        try:data[area]=min(4096,len(list(P(path).iterdir())))
        except OSError:pass
    try:
        raw,_=bounded_file("/proc/stat",limit=65536)
        for line in raw.splitlines():
            m=re.match(r"^(procs_running|procs_blocked|processes) ([0-9]+)$",line)
            if m:data[m[1]]=int(m[2])
    except (OSError,ValueError):pass
    return data
def assess(metrics,sources,history):
    events={k:sum(s["events"].get(k,0) for s in sources) for k in CATEGORIES}
    # Duplicate sources may overlap. These are observations, not unique incident counts.
    findings=[]
    for k,n in events.items():
        if n:findings.append({"code":k,"level":"critical" if k in CRITICAL else "warning","observations":n})
    total=metrics.get("memory_total_kib",0);avail=metrics.get("memory_available_kib")
    lowmem=bool(total and avail is not None and avail/total<0.15)
    lowdisk=any(metrics.get(x+"_total_bytes",0)>0 and metrics.get(x+"_free_bytes",10**30)/metrics[x+"_total_bytes"]<0.15 for x in ("root","home","apt"))
    inode=any(metrics.get(x+"_inode_free_pct",100)<5 for x in ("root","home","apt"))
    if lowmem:findings.append({"code":"low_available_memory","level":"warning","observations":1})
    if lowdisk:findings.append({"code":"low_disk_space","level":"warning","observations":1})
    if inode:findings.append({"code":"low_inodes","level":"warning","observations":1})
    critical_storage=bool(events["storage_io"] or events["filesystem"] or events["disk_health"] or any(metrics.get(x+"_readonly") for x in ("root","home","apt")))
    critical_other=bool(events["thermal"] or events["kernel_fault"] or metrics.get("max_temperature_c",0)>=90)
    if critical_other:findings.append({"code":"hardware_or_kernel_review","level":"critical","observations":1})
    if critical_storage:findings.append({"code":"storage_review_required","level":"critical","observations":1})
    # Unknown coverage never becomes a clean bill of health.
    storage_ok=all(x+"_total_bytes" in metrics and x+"_readonly" in metrics for x in ("root","home","apt"))
    package_ok=any(s["name"]=="dpkg-audit" and s["status"] in ("ok","empty") and not s["bounded"] and not s["events"] for s in sources)
    kernel_ok=any(s["name"] in ("kernel-journal-current-boot","kernel-ring") and s["status"] in ("ok","empty") and not s["bounded"] for s in sources)
    # A write-heavy action is permitted only with current storage telemetry and readable current kernel logs.
    eligible={"thumbnails":storage_ok and kernel_ok and not critical_storage and not critical_other,
              "archives":storage_ok and kernel_ok and package_ok and not critical_storage and not critical_other,
              "own_memory":True,"pause_monitoring":True}
    context="disk" if lowdisk or inode else "memory" if lowmem else "normal"
    reasons={"thumbnails":"Generated cache only; fresh native eligibility scan still required.",
             "archives":"Package downloads only; package audit and fresh native checks required.",
             "own_memory":"Release unused SysPulse allocator pages only.",
             "pause_monitoring":"Reduce SysPulse sampling, not system services."}
    recommendations={}
    for action in ACTIONS:
        h=history.get((context,action),{"attempts":0,"successes":0,"failures":0,"no_effect":0,"bytes":0})
        # Learn only from verified action-specific results. Repeated failures demote;
        # successful historical cleanup is not evidence of a speed increase.
        demoted=h["attempts"]>=3 and (h["failures"]+h["no_effect"])*2>=h["attempts"]
        default=eligible[action] and not demoted and (
            (action in ("thumbnails","archives") and context=="disk") or
            (action in ("own_memory","pause_monitoring") and context=="memory"))
        recommendations[action]={"allowed":bool(eligible[action]),"recommended":bool(default),
            "reason":reasons[action]+(" Blocked: storage/kernel coverage or health is insufficient." if not eligible[action] else "")+(" Repeated historical failures: manual review preferred." if demoted else ""),
            "history":h}
    return {"findings":findings,"coverage":{"sources":len(sources),"readable":sum(s["status"] in ("ok","empty","bounded","partial") for s in sources),
            "limited":sum(s["status"] not in ("ok","empty") for s in sources)},
            "context":context,"recommendations":recommendations,"critical_storage":critical_storage,"critical_other":critical_other}
def secure_db():
    require(os.geteuid()!=0,"Analysis must run as ordinary desktop user")
    # Fixed local path; no XDG redirection or arbitrary database CLI path.
    home=P.home();require(home.is_absolute() and home.resolve(strict=True)==home,"Home path redirected; local history disabled")
    root=home/".local"
    for path in (root,root/"state",root/"state/syspulse",root/"state/syspulse/diagnostics"):
        try:path.mkdir(mode=0o700)
        except FileExistsError:pass
        s=path.lstat();require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.getuid() and not s.st_mode&0o022,"Unsafe diagnostics directory")
    folder=root/"state/syspulse/diagnostics";require(not folder.stat().st_mode&0o077,"Diagnostics directory must be private")
    db=folder/"history.sqlite3"
    for f in (db,P(str(db)+"-wal"),P(str(db)+"-shm"),P(str(db)+"-journal")):
        if os.path.lexists(f):
            s=f.lstat();require(stat.S_ISREG(s.st_mode) and s.st_uid==os.getuid() and s.st_nlink==1 and not s.st_mode&0o077,"Unsafe diagnostics database file")
    return db
def connect(path):
    c=sqlite3.connect(path,timeout=4)
    c.execute("PRAGMA foreign_keys=ON")
    c.execute("PRAGMA trusted_schema=OFF")
    c.execute("PRAGMA journal_mode=DELETE")
    c.execute("PRAGMA secure_delete=ON")
    c.execute("PRAGMA busy_timeout=4000")
    ver=c.execute("PRAGMA user_version").fetchone()[0]
    require(ver in (0,1,2),"Unsupported diagnostics database version")
    if not ver:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS analysis(id TEXT PRIMARY KEY, utc INTEGER NOT NULL, boot TEXT NOT NULL, tick REAL NOT NULL, state TEXT NOT NULL CHECK(state IN ('ready','reserved','finished','invalid')), context TEXT NOT NULL, metrics TEXT NOT NULL, sources TEXT NOT NULL, assessment TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS boost(id TEXT PRIMARY KEY REFERENCES analysis(id) ON DELETE CASCADE, utc INTEGER NOT NULL, selected TEXT NOT NULL, outcome TEXT, before_metrics TEXT, after_metrics TEXT, owner_pid INTEGER NOT NULL, owner_start TEXT NOT NULL);
        PRAGMA user_version=1;
        """)
    if ver<2:
        c.executescript("""
        BEGIN IMMEDIATE;
        CREATE TABLE IF NOT EXISTS research(id TEXT PRIMARY KEY REFERENCES analysis(id) ON DELETE CASCADE, utc INTEGER NOT NULL, fingerprint TEXT NOT NULL, providers TEXT NOT NULL, data TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS research_budget(id INTEGER PRIMARY KEY CHECK(id=1), window_start INTEGER NOT NULL, calls INTEGER NOT NULL, last_call INTEGER NOT NULL, web_until INTEGER NOT NULL);
        PRAGMA user_version=2;
        COMMIT;
        """)
    return c
def key_lookup(provider):
    # Desktop keyring only; no env, plaintext configuration, arguments or database secret.
    status,raw,bounded=command(["secret-tool","lookup","application","syspulse","provider",provider],timeout=5,limit=512)
    return raw.strip() if status=="ok" and not bounded else None
def research_record(c,ident):
    row=c.execute("SELECT data FROM research WHERE id=?",(ident,)).fetchone()
    return json.loads(row[0]) if row else None
def reserve_budget(c,now,want_web):
    row=c.execute("SELECT window_start,calls,last_call,web_until FROM research_budget WHERE id=1").fetchone()
    start,count,last,until=row or (now,0,0,0)
    require(now>=last and now>=start,"Research clock rollback")
    if now-start>=86400:start,count=now,0
    require(count<4 and (not last or now-last>=60),"Local online research budget exhausted or cooling down")
    c.execute("INSERT OR REPLACE INTO research_budget VALUES(1,?,?,?,?)",(start,count+1,now,until))
    return not want_web or now>=until
def investigate(c,ident,providers,boot,tick,now,lookup=key_lookup,runner=research.run,clock_fn=clock,now_fn=lambda:int(time.time())):
    require(isinstance(providers,list) and providers and len(providers)<=3 and all(isinstance(x,str) and x in research.PROVIDERS for x in providers) and len(set(providers))==len(providers),"Invalid research consent")
    providers=sorted(providers);provider_json=json.dumps(providers)
    with c:
        c.execute("BEGIN IMMEDIATE")
        analysis=read_analysis(c,ident,boot,tick,now)
        p=research.profile(analysis);fp=research.fingerprint(p)
        old=research_record(c,ident)
        if old:return old
        if not p["codes"]:
