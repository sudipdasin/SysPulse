#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""Full-package updater. CLI accepts only fixed channels and a reviewed version.
A package-managed public trust anchor is preferred; older administrator-enrolled keys remain supported only when no bundled anchor is present. No trust on first network use.
"""
import contextlib
import hashlib
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

CHANNELS = ("stable", "beta", "alpha")
KEYS = Path("/etc/syspulse/update-keys")
BUNDLED_KEYS = Path("/usr/share/syspulse/update-keys")
BASE = "https://raw.githubusercontent.com/sudipdasin/SysPulse/updates-"
VERSION = re.compile(r"(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})(?:~(alpha|beta)(0|[1-9][0-9]{0,5}))?(?:~render[1-9][0-9]{0,5})?", re.ASCII)
LOCAL_VERSION = re.compile(r"(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})~(alpha|beta)(0|[1-9][0-9]{0,5})~local[1-9][0-9]{0,5}", re.ASCII)
ENV = {"PATH": "/usr/bin:/usr/sbin:/bin:/sbin", "HOME": "/root" if os.geteuid()==0 else "/nonexistent",
       "LANG": "C", "LC_ALL": "C", "DEBIAN_FRONTEND": "noninteractive"}

def version(value, *, allow_local=False):
    match = VERSION.fullmatch(value) if isinstance(value,str) else None
    if not match and allow_local and isinstance(value,str):
        match = LOCAL_VERSION.fullmatch(value)
    if not match:
        raise ValueError("Unsupported Debian release version.")
    return match.group(4) or "stable"

def secure_key(path):
    # Require ordinary, root-controlled files and directories, not links.
    for item in (path, *path.parents):
        try:
            info = item.lstat()
        except FileNotFoundError:
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if item == path:
            if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= 65536 or not info.st_mode & 0o004:
                return False
        elif not stat.S_ISDIR(info.st_mode):
            return False
    return True

def resolve_key(channel, bundled=BUNDLED_KEYS, legacy=KEYS):
    """Local trust initialization. The authenticated DEB supplies the key and pin.
    Never fall back if a shipped trust anchor is incomplete or corrupted.
    """
    if channel not in CHANNELS:
        raise ValueError("Unknown update channel.")
    key = bundled/(channel+".gpg")
    pin = bundled/(channel+".sha256")
    if os.path.lexists(key) or os.path.lexists(pin):
        if not secure_key(key) or not secure_key(pin):
            raise ValueError("Installed release trust anchor is incomplete or unsafe. Repair using a trusted package.")
        expected=pin.read_bytes().decode("ascii").strip()
        if not re.fullmatch(r"[0-9a-f]{64}",expected) or hashlib.sha256(key.read_bytes()).hexdigest()!=expected:
            raise ValueError("Installed release trust anchor failed integrity verification.")
        return key
    return legacy/(channel+".gpg")

def run(args, timeout=90):
    # Do not import caller APT_CONFIG, proxy settings, loader settings or PATH.
    env=ENV.copy()
    # APT_CONFIG is read before system config fragments. Only our locally created
    # configuration is allowed here; never import a caller-provided value.
    if args[0] in ("/usr/bin/apt-get","/usr/bin/apt-cache") and len(args)>2 and args[1]=="-c":
        env["APT_CONFIG"]=args[2]
    result = subprocess.run(args, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    if result.returncode:
        raise RuntimeError("Package manager operation failed. Check signed feed, network, locks and package state.")
    return result.stdout.decode("utf-8", "replace")

def installed():
    raw=run(["/usr/bin/dpkg-query","-W","-f=${db:Status-Status} ${Version} ${Architecture}","syspulse"],10)
    fields=raw.split()
    if len(fields)!=3 or fields[0]!="installed" or fields[2]!="amd64":
        raise RuntimeError("SysPulse must be fully installed as an amd64 Debian package.")
    version(fields[1], allow_local=True)
    return fields[1]

def newer(candidate, current):
    result=subprocess.run(["/usr/bin/dpkg","--compare-versions",candidate,"gt",current],env=ENV,timeout=5)
    if result.returncode not in (0,1):
        raise RuntimeError("Version comparison failed.")
    return result.returncode==0

@contextlib.contextmanager
def snapshot(key, url):
    if not secure_key(key):
        raise ValueError("Signing key missing or unsafe. The release maintainer must provision authenticated trust.")
    with tempfile.TemporaryDirectory(prefix="syspulse-update-") as name:
        work=Path(name)
        # _apt needs traversal; contents contain no private user data.
        work.chmod(0o755)
        for path in ("lists","archives","empty"):
            (work/path).mkdir(mode=0o755)
        source=work/"sources.list"
        # The flat suite "/" avoids a literal /./ URL and GitHub HTTP 307.
        # Keep redirects disabled and continue checking signed metadata.
        source.write_text(f"deb [arch=amd64 signed-by={key}] {url} /\n",encoding="ascii")
        config=work/"apt.conf"
        config.write_text('Dir::Etc::main "/dev/null";\nDir::Etc::parts "-";\n',encoding="ascii")
        opts=["-c",str(config)]
        for setting in (
            "Dir::Etc::sourcelist="+str(source), "Dir::Etc::sourceparts=-",
            "Dir::Etc::main=/dev/null", "Dir::Etc::parts=-",
            "Dir::Etc::trusted=/dev/null","Dir::Etc::trustedparts=-",
            "Dir::State::lists="+str(work/"lists"), "Dir::State::status=/var/lib/dpkg/status",
            "Dir::Cache::archives="+str(work/"archives"),"Dir::Cache::pkgcache=","Dir::Cache::srcpkgcache=",
            "APT::Architecture=amd64","Acquire::Languages=none",
            "Acquire::Check-Valid-Until=true","Acquire::Check-Date=true","Acquire::Max-ValidTime=2592000",
            "Acquire::AllowInsecureRepositories=false","Acquire::AllowDowngradeToInsecureRepositories=false",
            "APT::Get::AllowUnauthenticated=false","Acquire::https::Verify-Peer=true",
            "Acquire::https::Verify-Host=true","Acquire::https::AllowRedirect=false",
            "Acquire::https::Timeout=20","Acquire::Retries=0","APT::Update::Error-Mode=any",
            "APT::Get::List-Cleanup=false","DPkg::Lock::Timeout=15"):
            opts += ["-o",setting]
        run(["/usr/bin/apt-get",*opts,"update"],90)
        yield opts

def candidate(opts, channel, current):
    raw=run(["/usr/bin/apt-cache",*opts,"policy","syspulse"],15)
    match=re.search(r"^  Candidate: (\S+)$",raw,re.MULTILINE)
    if not match:
        raise RuntimeError("No valid candidate found in signed repository.")
    value=match.group(1)
    if value=="(none)" or value==current:
        return None
    if version(value)!=channel:
        raise RuntimeError("Candidate is outside the selected release channel.")
    return value if newer(value,current) else None

def check(channel, key, url):
    current=installed()
    if not secure_key(key):
        return "UNCONFIGURED "+current
    with snapshot(key,url) as opts:
        available=candidate(opts,channel,current)
        return "AVAILABLE "+available if available else "CURRENT "+current

def review_plan(plan, current, expected):
    """Accept exactly one reviewed amd64 upgrade, never commands from solver text."""
    if not isinstance(plan, str) or len(plan)>262144 or "\x00" in plan:
        raise RuntimeError("Update simulation output is incomplete or malformed.")
    lines=plan.splitlines()
    summary=[]; mutations=[]
    for raw in lines:
        line=raw.strip()
        if line.startswith(("E:","W:","N:")):
            raise RuntimeError("Update simulation reported a warning; review using the system package manager.")
        match=re.fullmatch(r"([0-9]{1,6}) upgraded, ([0-9]{1,6}) newly installed, ([0-9]{1,6}) to remove and ([0-9]{1,6}) not upgraded\.",line)
        if match:
            summary.append(tuple(map(int,match.groups())))
        elif line.split(maxsplit=1) and line.split(maxsplit=1)[0] in ("Inst","Conf","Remv","Purg"):
            mutations.append(line)
    if len(summary)!=1 or summary[0][:3]!=(1,0,0) or len(mutations)!=2:
        raise RuntimeError("Update requires other package changes or has incomplete simulation evidence.")
    package=r"syspulse(?::amd64)?"
    old=re.escape(current); new=re.escape(expected)
    # APT renders origin metadata between the version and final architecture.
    # Require the exact installed and target versions; never accept an origin as a version.
    inst=rf"Inst {package} \[{old}\] \({new} [^\r\n]*\[amd64\]\)"
    conf=rf"Conf {package} \({new} [^\r\n]*\[amd64\]\)"
    if not re.fullmatch(inst,mutations[0]) or not re.fullmatch(conf,mutations[1]):
        raise RuntimeError("Update simulation differs from the reviewed package and versions.")

def install(channel, expected, key, url):
    if os.geteuid()!=0:
        raise ValueError("Administrator authorization required.")
    if version(expected)!=channel:
        raise ValueError("Reviewed version does not belong to selected channel.")
    current=installed()
    if not newer(expected,current):
        raise ValueError("The reviewed version is not newer than the installed package.")
    with snapshot(key,url) as opts:
        if candidate(opts,channel,current)!=expected:
            raise RuntimeError("Candidate changed since review. Check again.")
        args=["/usr/bin/apt-get",*opts,"--no-remove","--only-upgrade","--no-install-recommends","--no-install-suggests"]
        target="syspulse="+expected
        plan=run([*args,"--simulate","install",target],30)
        review_plan(plan,current,expected)
        if installed()!=current:
            raise RuntimeError("Installed version changed. Check again.")
        # No timeout during dpkg mutation. Do not terminate it to simulate rollback.
        run([*args,"-y","install",target],None)
        if installed()!=expected:
            raise RuntimeError("Installed version was not verified. Review package manager state.")
        return "INSTALLED "+expected

def main():
    args=sys.argv[1:]
    if len(args) not in (2,3) or args[0] not in ("check","install") or args[1] not in CHANNELS or (args[0]=="check")!=(len(args)==2):
        raise ValueError("Usage: syspulse-apt-update check CHANNEL | install CHANNEL VERSION")
    mode,channel=args[:2]
    key=resolve_key(channel)
    url=BASE+channel+"/"
    print(check(channel,key,url) if mode=="check" else install(channel,args[2],key,url))

if __name__=="__main__":
    try:
        main()
    except (ValueError,RuntimeError,OSError,subprocess.TimeoutExpired) as error:
        # No command output or user environment is transmitted.
        print("ERROR "+str(error))
        sys.exit(1)
